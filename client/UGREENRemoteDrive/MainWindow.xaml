<Window x:Class="UGREENRemoteDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Style="{StaticResource {x:Type Window}}"
        Title="Techbase | Remote Drive" Height="870" Width="1040" MinHeight="640" MinWidth="840" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#15253A" Padding="30,22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="/UGREENRemoteDrive;component/Assets/TechbaseLogo.png" Width="212" Height="59" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Techbase"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="REMOTE DRIVE" Foreground="White" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Right"/>
                    <TextBlock Text="Je bestanden. Binnen handbereik." Foreground="#BAC5D4" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,24,30,20">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Je Techbase-schijf" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="Verbind je NAS en werk direct vanuit Windows Verkenner." Style="{StaticResource Caption}" Margin="0,5,0,16"/>
                            <TextBlock x:Name="StatusText" Text="Niet verbonden" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="BackendText" Text="Verbinding: geen" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="ConnectButton" Content="Verbinden en schijf openen" Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click"/>
                            <Button x:Name="UnmountButton" Content="Schijf ontkoppelen" Margin="0,8,0,0" Click="UnmountButton_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TabControl>
                    <TabItem Header="_Verbinding">
                        <StackPanel>
                            <StackPanel x:Name="DirectConnectionPanel" Margin="0,0,0,16">
                                <TextBlock Text="Thuis of onderweg" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="De hoofdknop probeert eerst je lokale netwerk en daarna ingebouwde Tailscale. Aanmelden gebeurt in een apart venster." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="01  /  LOKAAL NETWERK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="Op kantoor of thuis" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                        <TextBlock Text="Gebruik de lokale Techbase-share als je bij de NAS bent." Style="{StaticResource Caption}" MinHeight="40"/>
                                        <Label Target="{Binding ElementName=SmbPathBox}" Content="_Netwerkadres" Padding="0" Margin="0,14,0,5"/>
                                        <TextBox x:Name="SmbPathBox" ToolTip="Alleen de share-root: \\NASNAAM\Techbase. Geen submap."/>
                                        <TextBlock Text="Bijvoorbeeld: \\NASNAAM\Techbase" Style="{StaticResource Caption}" Margin="0,5,0,14"/>
                                        <Button x:Name="SmbSignInButton" Content="Aanmelden bij NAS" HorizontalAlignment="Left" Click="SmbSignInButton_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="02  /  INGEBOUWDE TAILSCALE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="Veilig onderweg" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,6"/>
                                        <TextBlock Text="Verbind met je NAS zonder aparte Tailscale-app op Windows." Style="{StaticResource Caption}" MinHeight="40"/>
                                        <Label Target="{Binding ElementName=TailscaleHostBox}" Content="_Tailscale-adres van je NAS" Padding="0" Margin="0,14,0,5"/>
                                        <TextBox x:Name="TailscaleHostBox" ToolTip="Volledige naam eindigend op .ts.net, of je Tailscale 100.64–127.x.x-adres. Geen https of sharepad."/>
                                        <TextBlock Text="Eenmalig een verbindingssleutel nodig." Style="{StaticResource Caption}" Margin="0,5,0,14"/>
                                        <Button x:Name="ConnectTailscaleButton" Content="Via Tailscale verbinden" HorizontalAlignment="Left" Click="ConnectTailscaleButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <Expander Header="Alternatief: UGREENlink">
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Text="Gebruik je NAS-link of de Remote Drive-snelkoppeling. De officiële UGREEN-aanmelding opent in een apart venster." Style="{StaticResource Caption}"/>
                                        <Label Target="{Binding ElementName=RemoteUrlBox}" Content="_UGREENlink-adres" Padding="0" Margin="0,12,0,5"/>
                                        <TextBox x:Name="RemoteUrlBox" ToolTip="https://ug.link/… of je Remote Drive-appadres. Voor LAN of Tailscale mag dit leeg blijven."/>
                                        <Button x:Name="RemoteConnectButton" Content="UGREENlink openen" HorizontalAlignment="Left" Margin="0,12,0,0" Click="RemoteConnectButton_Click"/>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="_Instellingen">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Schijf en opstarten" FontSize="19" FontWeight="SemiBold"/>
                                    <Label Content="_Schijfletter" Target="{Binding ElementName=DriveLetterBox}" Padding="0" Margin="0,16,0,5"/>
                                    <ComboBox x:Name="DriveLetterBox" Width="100" HorizontalAlignment="Left"/>
                                    <CheckBox x:Name="StartupBox" Content="Start en koppel automatisch bij Windows-aanmelding" Margin="0,16,0,0"/>
                                    <CheckBox x:Name="AutoOpenShortcutBox" Content="Automatisch verbinden en Remote Drive-tegel openen" Margin="0,10,0,0" Click="ConnectionPreferencesChanged"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="UGREENlink-aanmelding" FontSize="19" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="RememberLoginBox" Content="UGREENlink-aanmelding onthouden" Margin="0,16,0,12" Click="ConnectionPreferencesChanged"/>
                                    <Label Content="_Naam van de NAS-tegel" Target="{Binding ElementName=ShortcutTileNameBox}" Padding="0" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ShortcutTileNameBox" ToolTip="Exacte naam van de Remote Drive-tegel op het NAS-bureaublad."/>
                                    <TextBlock Text="Je NAS-wachtwoord kun je apart onthouden in het aanmeldvenster. De Tailscale-identiteit blijft beschermd op deze computer." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Opgeslagen aanmeldingen beheren" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock Text="Wissen kan betekenen dat je opnieuw moet aanmelden. Tailscale wissen verwijdert alleen de toestemming van deze app." Style="{StaticResource Caption}" Margin="0,6,0,14"/>
                                    <WrapPanel>
                                        <Button x:Name="ForgetSmbButton" Content="Lokale NAS-aanmelding vergeten" Click="ForgetSmbButton_Click" Margin="0,0,10,10"/>
                                        <Button x:Name="ForgetTailscaleButton" Content="Tailscale-toestemming wissen" Click="ForgetTailscaleButton_Click" Margin="0,0,10,10"/>
                                        <Button x:Name="ForgetLoginButton" Content="UGREENlink-aanmelding wissen" Click="ForgetLoginButton_Click" Margin="0,0,0,10"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="30,12">
            <DockPanel>
                <TextBlock Text="TECHBASE  /  REMOTE DRIVE" Style="{StaticResource Caption}" FontSize="11"/>
                <TextBlock Text="Alleen de gedeelde map Techbase" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <!-- Moved to the owned UGREENlink popup after initialization. -->
        <Border x:Name="BrowserHost" Visibility="Collapsed" Background="White"><wv2:WebView2 x:Name="Browser"/></Border>
    </Grid>
</Window>
