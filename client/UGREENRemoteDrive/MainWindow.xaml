<Window x:Class="UGREENRemoteDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="UGREEN Remote Drive" Height="710" Width="900" MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="UGREEN Remote Drive" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Eén klik koppelt alleen de Techbase-map als Windows-schijf U:." Foreground="#555" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="UGREENlink-adres van je NAS of de Remote Drive-snelkoppeling" FontWeight="SemiBold" />
            <TextBox x:Name="RemoteUrlBox" Height="32" Margin="0,4,0,0" VerticalContentAlignment="Center"
                     ToolTip="Vul https://ug.link/… in, meld aan en open zelf de Remote Drive-tegel. De app onthoudt daarna automatisch het aparte app-adres." />
            <TextBlock Text="Voor ingebouwde Tailscale mag dit leeg blijven. Vul bij Optioneel de Tailscale-naam van je NAS in. UGREENlink is een alternatief met een apart aanmeldvenster."
                       FontSize="11" Foreground="#666" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Expander Grid.Row="2" Header="Optioneel: aanmelding, automatisch verbinden en LAN/SMB" Margin="0,0,0,12">
            <StackPanel Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Techbase SMB-share op je lokale netwerk (optioneel)" FontWeight="SemiBold" />
                    <TextBox x:Name="SmbPathBox" Height="30" Margin="0,4,0,0" VerticalContentAlignment="Center"
                             ToolTip="Alleen de share-root: \\NASNAAM\Techbase op het LAN, of \\10.203.0.1\Techbase via de directe WireGuard-container." />
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="SmbSignInButton" Content="Aanmelden bij NAS" Padding="10,5" Margin="0,0,8,0" Click="SmbSignInButton_Click" />
                        <Button x:Name="ForgetSmbButton" Content="NAS-aanmelding vergeten" Padding="10,5" Click="ForgetSmbButton_Click" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="88" Margin="0,0,14,0">
                    <TextBlock Text="Schijfletter" FontWeight="SemiBold" />
                    <ComboBox x:Name="DriveLetterBox" Height="30" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="ForgetLoginButton" Grid.Column="2" Content="UGREENlink-aanmelding wissen"
                        Padding="10,6" VerticalAlignment="Bottom" Click="ForgetLoginButton_Click" />
            </Grid>
            <TextBlock Text="Tailscale NAS-naam of Tailscale IPv4-adres (zonder aparte VPN-app)" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBox x:Name="TailscaleHostBox" Height="30" Margin="0,4,0,0" VerticalContentAlignment="Center"
                     ToolTip="Volledige NAS-naam eindigend op .ts.net, of het Tailscale 100.64–127.x.x-adres. Geen https of sharepad." />
            <WrapPanel Margin="0,6,0,0">
                <Button x:Name="ConnectTailscaleButton" Content="Verbinden via ingebouwde Tailscale" Padding="10,5" Margin="0,0,8,0" Click="ConnectTailscaleButton_Click" />
                <Button x:Name="ForgetTailscaleButton" Content="Tailscale-toestemming wissen" Padding="10,5" Click="ForgetTailscaleButton_Click" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
                <CheckBox x:Name="RememberLoginBox" Content="UGREENlink-aanmelding onthouden" Margin="0,0,18,0" Click="ConnectionPreferencesChanged"
                          ToolTip="Gebruikt de eigen browseropslag en de optie ingelogd blijven van UGREEN. Je kunt eenmalig de browservraag om je wachtwoord te bewaren accepteren." />
                <CheckBox x:Name="AutoOpenShortcutBox" Content="Automatisch verbinden en Remote Drive-tegel openen" Click="ConnectionPreferencesChanged" />
            </WrapPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Naam van de NAS-tegel" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="ShortcutTileNameBox" Height="28" VerticalContentAlignment="Center"
                         ToolTip="Exacte naam op het NAS-bureaublad. Een goedgekeurde handmatige tegelklik wordt automatisch onthouden." />
            </DockPanel>
            </StackPanel>
        </Expander>

        <WrapPanel Grid.Row="3" Margin="0,0,0,10" VerticalAlignment="Center">
            <Button x:Name="ConnectButton" Content="Verbinden en schijf openen" Padding="16,8" Margin="0,0,10,0"
                    FontWeight="SemiBold" Click="ConnectButton_Click" />
            <Button x:Name="RemoteConnectButton" Content="UGREENlink openen" Padding="12,8" Margin="0,0,10,0"
                    Click="RemoteConnectButton_Click" />
            <Button x:Name="UnmountButton" Content="Schijf ontkoppelen" Padding="12,8" Margin="0,0,12,0"
                    Click="UnmountButton_Click" IsEnabled="False" />
            <CheckBox x:Name="StartupBox" Content="Start en koppel automatisch aan bij Windows-aanmelding"
                      VerticalAlignment="Center" />
        </WrapPanel>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F2F5F8" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock Text="Status" FontWeight="SemiBold" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusText" Text="Niet verbonden" TextWrapping="Wrap" />
                    <TextBlock x:Name="BackendText" Text="Backend: geen" DockPanel.Dock="Right" Foreground="#555" Margin="12,0,0,0" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <StackPanel x:Name="DirectConnectionPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="550">
                    <TextBlock Text="Je NAS in Verkenner" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="Thuis via je lokale netwerk, onderweg met ingebouwde Tailscale. Geen aparte Tailscale-app nodig. Je NAS-gebruikersnaam en wachtwoord voer je in een pop-up in."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#555" Margin="0,12,0,0" />
                    <TextBlock Text="Vul je NAS-gegevens in bij Optioneel en klik op Verbinden. Tailscale vraagt eenmalig een verbindingssleutel; daarna onthoudt deze app zijn eigen verbinding."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#555" Margin="0,10,0,0" />
                </StackPanel>
                <Border x:Name="BrowserHost" Visibility="Collapsed" BorderBrush="#D5DADF" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <wv2:WebView2 x:Name="Browser" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
