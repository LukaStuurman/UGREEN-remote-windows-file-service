<Window x:Class="UGREENRemoteDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="UGREEN Remote Drive" Height="780" Width="900" MinHeight="680" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="UGREEN Remote Drive" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Eén klik koppelt alleen de Techbase-map als Windows-schijf U:." Foreground="#555" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="UGREENlink-adres van de NAS Docker-snelkoppeling" FontWeight="SemiBold" />
            <TextBox x:Name="RemoteUrlBox" Height="32" Margin="0,4,0,0" VerticalContentAlignment="Center"
                     ToolTip="Plak hier het HTTPS-adres van je UGREEN Docker-snelkoppeling." />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Toegangscode van de NAS-service" FontWeight="SemiBold" />
            <PasswordBox x:Name="TokenBox" Height="32" Margin="0,4,0,0" VerticalContentAlignment="Center" />
            <TextBlock x:Name="TokenHint"
                       Text="Eenmalig nodig om de Techbase-service te autoriseren; veilig versleuteld op deze pc bewaard."
                       FontSize="11" Foreground="#666" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Expander Grid.Row="3" Header="Optioneel: LAN/SMB en andere schijfletter" Margin="0,0,0,12">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Techbase SMB-share (alleen thuis op het LAN)" FontWeight="SemiBold" />
                    <TextBox x:Name="SmbPathBox" Height="30" Margin="0,4,0,0" VerticalContentAlignment="Center"
                             ToolTip="Alleen de share-root, bijvoorbeeld \\NASNAAM\Techbase." />
                </StackPanel>
                <StackPanel Grid.Column="1" Width="88" Margin="0,0,14,0">
                    <TextBlock Text="Schijfletter" FontWeight="SemiBold" />
                    <ComboBox x:Name="DriveLetterBox" Height="30" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="ForgetLoginButton" Grid.Column="2" Content="Wis lokale aanmelding"
                        Padding="10,6" VerticalAlignment="Bottom" Click="ForgetLoginButton_Click" />
            </Grid>
        </Expander>

        <WrapPanel Grid.Row="4" Margin="0,0,0,10" VerticalAlignment="Center">
            <Button x:Name="ConnectButton" Content="Verbinden en schijf openen" Padding="16,8" Margin="0,0,10,0"
                    FontWeight="SemiBold" Click="ConnectButton_Click" />
            <Button x:Name="UnmountButton" Content="Schijf ontkoppelen" Padding="12,8" Margin="0,0,12,0"
                    Click="UnmountButton_Click" IsEnabled="False" />
            <CheckBox x:Name="StartupBox" Content="Start en koppel automatisch aan bij Windows-aanmelding"
                      VerticalAlignment="Center" />
        </WrapPanel>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F2F5F8" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock Text="Status" FontWeight="SemiBold" DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusText" Text="Niet verbonden" TextWrapping="Wrap" />
                    <TextBlock x:Name="BackendText" Text="Backend: geen" DockPanel.Dock="Right" Foreground="#555" Margin="12,0,0,0" />
                </DockPanel>
            </Border>
            <Border Grid.Row="1" BorderBrush="#D5DADF" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <wv2:WebView2 x:Name="Browser" />
            </Border>
        </Grid>
    </Grid>
</Window>
