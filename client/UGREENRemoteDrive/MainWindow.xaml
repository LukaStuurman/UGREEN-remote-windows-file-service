<Window x:Class="UGREENRemoteDrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="UGREEN Remote Drive" Height="850" Width="1000" MinHeight="700" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="UGREEN Remote Drive" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Koppel via UGREENlink; thuis gebruikt de client automatisch SMB als dat beschikbaar is." Foreground="#555" Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,8">
                <TextBlock Text="UGREENlink-appadres (ugapp.link)" FontWeight="SemiBold" />
                <TextBox x:Name="RemoteUrlBox" Height="30" Margin="0,4,0,0" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="0" Margin="10,0,0,8">
                <TextBlock Text="Toegangstoken" FontWeight="SemiBold" />
                <PasswordBox x:Name="TokenBox" Height="30" Margin="0,4,0,0" VerticalContentAlignment="Center" />
                <TextBlock x:Name="TokenHint" Text="Opgeslagen token blijft verborgen en wordt met DPAPI versleuteld." FontSize="11" Foreground="#666" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                <TextBlock Text="SMB-share op je LAN (optioneel)" FontWeight="SemiBold" />
                <TextBox x:Name="SmbPathBox" Height="30" Margin="0,4,0,0" VerticalContentAlignment="Center" ToolTip="Bijvoorbeeld \\NASNAAM\Share" />
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Bottom">
                <StackPanel Width="100" Margin="0,0,12,0">
                    <TextBlock Text="Driveletter" FontWeight="SemiBold" />
                    <ComboBox x:Name="DriveLetterBox" Height="30" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="SaveButton" Content="Instellingen opslaan" Padding="14,7" Margin="0,4,8,0" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
        <WrapPanel Grid.Row="2" Margin="0,2,0,10">
            <Button x:Name="ConnectButton" Content="Aanmelden / verbinden" Padding="14,7" Margin="0,0,8,0" Click="ConnectButton_Click" />
            <Button x:Name="MountButton" Content="Koppel schijf" Padding="14,7" Margin="0,0,8,0" Click="MountButton_Click" />
            <Button x:Name="UnmountButton" Content="Ontkoppel" Padding="14,7" Margin="0,0,8,0" Click="UnmountButton_Click" IsEnabled="False" />
            <Button x:Name="ForgetLoginButton" Content="Wis lokale UGREENlink-aanmelding" Padding="14,7" Margin="0,0,8,0" Click="ForgetLoginButton_Click" />
            <CheckBox x:Name="StartupBox" Content="Start bij Windows-aanmelding" VerticalAlignment="Center" Margin="8,0,0,0" />
        </WrapPanel>
        <Border Grid.Row="3" Background="#F2F5F8" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="Status" FontWeight="SemiBold" DockPanel.Dock="Left" Margin="0,0,10,0" />
                <TextBlock x:Name="StatusText" Text="Niet verbonden" />
                <TextBlock x:Name="BackendText" Text="Backend: geen" DockPanel.Dock="Right" Foreground="#555" />
            </DockPanel>
        </Border>
        <Border Grid.Row="4" BorderBrush="#D5DADF" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <wv2:WebView2 x:Name="Browser" />
        </Border>
    </Grid>
</Window>
