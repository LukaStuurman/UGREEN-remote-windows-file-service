<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>UGREENRemoteDrive</AssemblyName>
    <RootNamespace>UGREENRemoteDrive</RootNamespace>
    <ApplicationIcon>Assets\Techbase.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\TechbaseLogo.png" />
    <Resource Include="Assets\Techbase.ico" />
    <EmbeddedResource Include="..\..\embedded-tailscale\UGREENTailscale.exe" LogicalName="UGREENRemoteDrive.Embedded.UGREENTailscale.exe" Condition="Exists('..\..\embedded-tailscale\UGREENTailscale.exe')" />
    <EmbeddedResource Include="..\..\embedded-tailscale\THIRD-PARTY-NOTICES.txt" LogicalName="UGREENRemoteDrive.Embedded.NOTICES.txt" Condition="Exists('..\..\embedded-tailscale\THIRD-PARTY-NOTICES.txt')" />
    <EmbeddedResource Include="Browser\DesktopAutomation.js" />
    <EmbeddedResource Include="Browser\RemoteTransport.js" />
    <PackageReference Include="DokanNet" Version="2.3.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
