<Window x:Class="UGREENRemoteDrive.TailscaleKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tailscale eenmalig instellen" Width="490" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Tailscale eenmalig instellen" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="Een beheerder van je Tailscale-netwerk kan een eenmalige auth key aanmaken. Vul die hieronder in om deze app toestemming te geven. Je hoeft niet bij Tailscale in te loggen in deze app."
                   TextWrapping="Wrap" Margin="0,12,0,14" />
        <TextBlock Text="Tailscale-verbindingssleutel (tskey-auth-…)" />
        <PasswordBox x:Name="KeyBox" Height="32" Margin="0,5,0,12" VerticalContentAlignment="Center" MaxLength="1024" />
        <TextBlock Text="De sleutel wordt niet in instellingen of logs opgeslagen. Windows beschermt daarna de eigen Tailscale-identiteit van deze app. Toegangsregels en goedkeuring door je beheerder blijven gelden."
                   TextWrapping="Wrap" Foreground="#555" FontSize="11" />
        <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Foreground="#9B2525" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Annuleren" IsCancel="True" Padding="14,7" Margin="0,0,10,0" />
            <Button x:Name="AuthorizeButton" Content="Verbinding toestaan" IsDefault="True" Padding="14,7" Click="Authorize_Click" />
        </StackPanel>
    </StackPanel>
</Window>
