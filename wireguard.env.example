# Copy to a private .env file or enter these in the UGREEN Docker project.
# NAS_ADDRESS is the NAS LAN IPv4. WG_ENDPOINT is your own public IPv4/DDNS.
# Never use a UGREENlink address here. No keys/passwords belong in this file.
NAS_ADDRESS=
WG_ENDPOINT=
WG_PORT=51820
UGREEN_DRIVE_REF=v0.4.0-preview.1
