# Set these values in the UGREEN Docker project's environment fields.
# Exact host path of the UGOS shared folder named Techbase; verify this in UGOS.
# Never point this at /volume1 or a parent directory containing other shares.
DATA_PATH=/replace-with-verified-Techbase-host-path
UGREEN_DRIVE_REF=main
PUID=1000
PGID=10
UGREEN_DRIVE_TOKEN=replace-with-at-least-32-random-characters
